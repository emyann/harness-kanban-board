{
  "name": "hkb-cli",
  "version": "0.2.2",
  "description": "hkb — harness kanban board. A portable, frugal Hermes-style kanban for coding agents; GitHub Issues is the default backend, any harness (Claude Code, Copilot CLI, Codex) is a worker.",
  "type": "module",
  "bin": {
    "hkb": "bin/hkb.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "skills",
    "commands",
    "hooks",
    "templates",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "for f in bin/hkb.js src/*.js src/*/*.js scripts/*.mjs; do node --check \"$f\" || exit 1; done && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "kanban",
    "github",
    "github-issues",
    "agents",
    "cli",
    "claude-code",
    "copilot",
    "codex",
    "hermes"
  ],
  "license": "MIT",
  "author": "emyann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emyann/harness-kanban-board.git"
  },
  "homepage": "https://github.com/emyann/harness-kanban-board#readme",
  "bugs": {
    "url": "https://github.com/emyann/harness-kanban-board/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
