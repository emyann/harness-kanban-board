{
  // Not a build. `tsc --noEmit` reads the JSDoc the sources already carry and checks it — nothing is
  // compiled and nothing is emitted, so hkb stays dependency-free at runtime: `node bin/hkb.js` in a
  // fresh clone works with no `npm install`. Track C turns the sources into `.ts`; this file grows
  // into that config rather than being replaced.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": false,
    "skipLibCheck": true,
    // `.ts` import specifiers are what let Node run the sources with no build step
    // (Node does not remap `./x.js` onto `x.ts`), so tsc has to accept them too.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["bin/**/*.js", "src/**/*.js", "src/**/*.ts", "scripts/**/*.mjs", "types/**/*.d.ts", "prisma.config.ts"],
  // The Prisma client is generated, ships `@ts-nocheck`, and is checked by Prisma's own
  // release process — type-checking 788K of it on every `npm run lint` buys nothing.
  "exclude": ["node_modules", "src/generated"]
}
