// The core: one kind, and the three tables it needs.
//
// The kind is a **Job** — one agent, one brief, run to completion, with a retry budget. It is the
// hkb equivalent of a Kubernetes Job, and the mapping is close enough to be worth stating in the
// schema itself, because it is what keeps the next kind from being invented twice:
//
//   Job       a Kubernetes Job     what should happen, and how many times we may try
//   Attempt   a Pod                one execution of it — this is the thing that dies
//   Lease     a Lease              who holds it right now, and until when
//   Board     a Namespace          a name to group jobs under
//   Event     the event stream     what happened, in order
//
// The DAG is deliberately NOT here. A dependency graph is a *second* kind whose controller
// creates Jobs, the way a CronJob creates Jobs — so `Link`, and the todo/ready/blocked vocabulary
// that only a graph needs, come back with it rather than sitting in a core that cannot use them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

/// Where a Job is in its lifecycle. Observed state, never asked for directly — except for `triage`
/// and the last three, which are the states only a human can put a Job in.
///
/// `triage` is the only one of those that is an ENTRY rather than an exit, and it exists because
/// `pending` means *wants to run*: a daemon claims it. There was nowhere to put "I noticed this, do
/// not run it yet", so the choice was to file work you had not decided on or to lose it — and the
/// workarounds (stop the board, drain it to zero concurrency) are board-wide answers to a
/// per-Job question. A Job in `triage` is never claimed, and that costs no guard: the claim query
/// asks for `pending` (ADR-011 named this gap and left it open).
enum Phase {
  triage     // filed, and not yet work: somebody noticed it, nobody has decided
  pending    // wants to run, nothing holds it
  running    // a lease is held and an attempt is live
  succeeded  // terminal: the session completed
  failed     // terminal: out of retries
  suspended  // waiting on a human — the one state no runtime can report
  done       // terminal: an operator says the aim was achieved by other means
  cancelled  // terminal: an operator says stop, this is not wanted
}
// `done` and `cancelled` are two values rather than one, and neither is `suspended`. Both arguments
// were made when they were added, and both are worth keeping here because the pull is to collapse
// them later:
//
// NOT `suspended`. That state is a *wait*: something is expected to happen and then the Job goes on
// — "waiting for an answer, resumable, with a proposal pending" is the shape it was put in the
// schema for. `kb ls --phase suspended` is therefore an inbox, the list of what still needs a
// human, and it is the one query the state exists to answer. A Job concluded by hand would sit in
// that inbox for ever, because nothing is ever going to take it out: the list stops meaning "what
// needs me" the first time it is used this way. The reasons even read in opposite tenses —
// `suspendedFor` is what someone must still do, `endedFor` is what already happened.
//
// TWO values, not one `ended` with the statement in a column. This enum already splits its terminal
// states by what happened — `succeeded` and `failed` are both "never claim this again", and are
// separate because the difference is what an operator reads. The difference between "the PR was
// merged, this is finished" and "we do not want this" is at least that large, it is the entire
// content of the operator's decision, and putting it in a column would make these the only terminal
// phases whose name has to be read together with a second field to mean anything. `kb ls --phase
// cancelled` also comes free, off an index that already exists.

/// How one attempt ended. The three resumable ones are why this is not a boolean.
enum Outcome {
  completed
  max_turns   // resumable: it did work and left a session
  max_budget  // resumable: same
  timed_out   // resumable: the wall clock ran out, not the model
  refused
  crashed
  no_output   // the session ended, but a path the Job DECLARED is not there. Not a crash and not a
              // refusal: the process did what it was asked and the contract still was not met, which
              // is the outcome ADR-008 exists to make expressible.
  no_input    // the run never started: an input the Job DECLARED could not be read. The mirror of
              // `no_output` on the read side, and a separate value because the two send an operator
              // to different places — `no_output` is a fault in the work, `no_input` is a fault in
              // the spec or in the repository, and it cost nothing to find out.
  /// **Historical.** Nothing writes this since the rebase left the core (ADR-018); it is kept so
  /// rows that already carry it still read back.
  conflicted  // the session ended and the work is real, but the branch cannot be put on the base it
              // will be merged into. Three ways (`src/rebase.ts`): the replay hit a conflict, the
              // remote refused the lease because somebody else moved the branch, or the replay
              // worked and the worker's uncommitted files would not come back with it. Its own value
              // rather than `no_output` because the fault is in neither the work nor the spec: the
              // base moved, and the fix is a hand rebase rather than another run. A push that never
              // REACHED the remote is deliberately not here — that is ours, and it is said out loud
              // without failing an attempt whose work is already pushed.
  check_failed // the session ended and everything declared is there, and the command the Job named
              // as its completion condition exited non-zero in the rebased checkout (ADR-016 §3,
              // `src/check.ts`). hkb's container is an agent session and it always finishes
              // successfully, so hkb has no exit code of its own; `exports`/`results`/`artifacts`
              // reconstruct one for files and this reconstructs one for BEHAVIOUR. Transient and
              // resumable, unlike `no_output`: the session is worth continuing precisely because it
              // is the session that wrote the code the check refused, and the next attempt is told
              // the command, the exit code and the tail of what it printed.
  deadline_exceeded // the JOB's own wall clock ran out, across every attempt it has had
              // (`Job.activeDeadlineSeconds`). Kubernetes' `reason: DeadlineExceeded`, and its rule
              // comes with it: this **outranks the retry budget**. A Job past its deadline does not
              // get another attempt however many retries remain, because the thing that ran out is
              // not this attempt's — it is the Job's. Distinct from `timed_out`, which is one
              // attempt's clock and IS resumable: the two send an operator to different places, one
              // to raise a per-attempt clock and the other to decide whether the Job is worth more
              // wall time at all.
  lost        // the lease expired with nobody reporting — the attempt was never heard from again
  stopped     // the operator stopped the daemon mid-run. Resumable, and it does NOT spend a retry:
              // `kb down` is not a failure of the work, and charging one would mean a Job could be
              // exhausted by nothing but being turned off.
}

model Board {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  jobs  Job[]

  /// The repository this board's Jobs run in, as an absolute path on this machine.
  ///
  /// It lives here rather than on the Job because a Job is inherently single-repo — one worktree,
  /// one branch, one pull request — and because a Board is the Namespace: the ceilings below are
  /// already per-repo facts ("this repo's PR workflows are expensive, run one at a time"). Two
  /// boards may share a repo if they want different budgets for different work.
  ///
  /// Nullable so a board can exist before it is pointed at anything, and so tests can supply a
  /// checkout directly. A Job on a board with no repoPath falls back to the caller's cwd.
  repoPath String?

  /// The kill switch. While this is set nothing is claimed; a run already going is left alone,
  /// because stopping a board should not destroy work in flight.
  pausedAt DateTime?
  pausedBy String?

  /// Ceilings, checked BEFORE a claim and never mid-run. A ceiling that could stop a running
  /// worker would strand its worktree; one that refuses to start another is just a decision.
  /// `dailyBudgetUsd` is a rolling 24 hours, not a calendar day — there is no timezone to get wrong.
  /// It is charged against what running work *could* cost, in-flight attempts included, so that a
  /// board running several Jobs at once cannot commit its ceiling several times over.
  dailyBudgetUsd Float?
  /// How many Jobs this board runs at once. Really at once: one reconcile pass starts up to this
  /// many and waits for them together (`src/controller.ts`). It is a ceiling on *leases*, so it
  /// also binds across reconcilers — but it is not only that, and it was for one release, which is
  /// why this comment exists. 0 drains the board without stopping it.
  maxConcurrent  Int   @default(1)

  /// Spec defaults for the Jobs filed on this board. Null means "no opinion — ask the next level".
  ///
  /// The same kind of fact as the ceilings above. A board that runs cheap, high-volume work knows
  /// which model that work wants, and saying so once beats `--model` on every `kb new`. What keeps
  /// them separate columns rather than one is that a ceiling and a default are opposites in who
  /// wins: a Job may not exceed `dailyBudgetUsd`, and it may freely override `defaultModel`.
  ///
  /// Resolution is in `src/spec.ts`: the Job's own value wins, the Board's default fills a null,
  /// the built-in is the last resort. The deadlines have twins here now — something asked
  /// for one, and each default costs a column, a flag and a line of provenance in `kb show`.
  defaultModel        String?
  defaultEffort       String?
  defaultMaxTurns     Int?
  /// The two deadlines, in seconds. `defaultAttemptDeadlineSeconds` fills a Job that named no
  /// per-attempt clock; `defaultActiveDeadlineSeconds` gives a board a Job-wide ceiling every Job
  /// filed here inherits. Both are *defaults*, freely overridden on the Job — a ceiling nobody can
  /// exceed is `dailyBudgetUsd` and `maxConcurrent`, and these are not that.
  defaultAttemptDeadlineSeconds Int?
  defaultActiveDeadlineSeconds  Int?
  defaultMaxBudgetUsd Float?
  defaultMaxRetries   Int?
  /// The board's default tool surface, filling a Job that named none. A default, not a ceiling:
  /// a Job may name a *wider* list and get it. The ceiling a Job cannot exceed is
  /// `dailyBudgetUsd`/`maxConcurrent` in `src/limits.ts`; this is `src/spec.ts` territory.
  defaultAllowedTools Json?
  /// The board's plugin grants, filling a null on the Job the way every other default does
  /// (`src/spec.ts`). Board-wide is the common case — "every Job on this repository may see its
  /// own skills" — and the per-Job column is for narrowing, not widening.
  defaultPluginPaths  Json?

  /// The guide every Job on this board reads unless it says otherwise (`Job.guide` wins). One
  /// `hkb boards set <slug> --guide CLAUDE.md` is how a repository's own rules reach its workers.
  defaultGuide        String?


  /// The completion check every Job on this board runs unless it says otherwise (`Job.check`
  /// wins). One `hkb boards set <slug> --check "npm test"` is how a repository's own gate reaches
  /// every worker on it. Null — the shipped default — means nothing runs.
  defaultCheck        String?

  /// The name of a workflow in `.hkb/workflows/` — how work on this board FINISHES.
  ///
  /// ADR-017 decision 1: a board's default workflow is a file, not code. The core tells a worker the
  /// sandbox contract and nothing else, so "push and open a pull request" has to come from
  /// somewhere, and a hand-filed Job (`hkb new --brief …`, no `--from`) had nowhere to get it. This
  /// is that somewhere.
  ///
  /// It composes differently from every other default here, and deliberately: the frontmatter fills
  /// spec nulls the way `--from` would, and the BODY is appended to the brief as standing steps
  /// (`src/templates.ts`). A Job filed WITH `--from` ignores it entirely — that workflow governs.
  /// Null, the shipped default, means a Job gets the sandbox contract and nothing else.
  defaultWorkflow     String?

  events Event[]

  controller Controller?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Who is reconciling a board right now — leader election, one leader per Board.
///
/// This is a Lease by another name, and deliberately so: the compare-and-swap is `@@id`, staleness
/// is `expiresAt` plus `holderLiveness`, and both were already written and tested for `Lease`. It
/// replaces a pid file, which was a second source of truth living outside the store and re-deriving
/// the same rules — badly, in one case: the pid file recorded a hostname and never read it back, so
/// on a shared filesystem it asked the wrong machine's process table.
///
/// A daemon serving every board holds one row per board. A daemon scoped to one board takes only
/// that row, and the two cannot both serve it — which is the whole reason the key is the board.
model Controller {
  boardId Int   @id
  board   Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  holder     String
  intervalMs Int
  /// What the daemon was running when it started. `kb up --status` compares it to the checkout so
  /// a daemon quietly serving old code is a line you can read rather than a thing you discover.
  version    String?

  startedAt DateTime @default(now())
  renewedAt DateTime @default(now())
  expiresAt DateTime
}

/// The primitive kind: run one agent against one brief until it is done.
model Job {
  id      Int    @id @default(autoincrement())
  boardId Int
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // ---- spec: what should happen. Set by whoever created the Job; never written by the controller.
  name         String
  brief        String
  /// Null on all five of these means "nobody said": the Board's default answers, and failing that
  /// `BUILT_IN` in `src/spec.ts` does. They carry no database default on purpose — a column that
  /// defaults to 20 cannot tell "the operator asked for 20" from "the operator said nothing", and
  /// without that distinction a Board default is outranked by every Job that ever existed, which is
  /// not a default at all. The built-in numbers moved to `src/spec.ts`, now the one place they are
  /// written down.
  model        String?
  effort       String?
  maxTurns     Int?
  /// **One attempt's wall clock**, in seconds — Kubernetes' `template.spec.activeDeadlineSeconds`
  /// (ADR-016). The model's own caps (turns, budget) cannot stop a session that has stalled, and a
  /// Pod that outruns this one fails with `DeadlineExceeded` and is *retried* subject to the
  /// backoff limit. That is exactly hkb's behaviour: `timed_out` is resumable and burns a retry.
  ///
  /// Nullable like the five above, and for the same reason: a column with a database default cannot
  /// tell "the operator asked for 30 minutes" from "the operator said nothing", so a board default
  /// would be outranked by every Job that ever existed. The built-in 1800 lives in `src/spec.ts`.
  ///
  /// Seconds, not milliseconds, because that is the unit Kubernetes named the field in and hkb does
  /// not invent a vocabulary where the map has one. The runtime seam still takes milliseconds
  /// (`WorkerSpec.timeoutMs`) — a driver's unit is the driver's business, and the seam is where hkb
  /// stops being Kubernetes-shaped.
  attemptDeadlineSeconds Int?
  /// **The whole Job's wall clock**, across every attempt — Kubernetes' `JobSpec
  /// .activeDeadlineSeconds`, measured from the first attempt's `startedAt`.
  ///
  /// The one above bounds a runaway *attempt*; this bounds a runaway *Job*. Without it a Job with
  /// three retries and a 90-minute attempt clock can occupy a slot for four and a half hours and
  /// still be "within its caps". Kubernetes draws exactly this distinction and hkb had only half of
  /// it, which ADR-016's map recorded as `resources.limits` — a row that is imprecise, since
  /// `resources.limits` is cpu and memory and a deadline is neither.
  ///
  /// **It takes precedence over `maxRetries`**, which is Kubernetes' rule and not a choice made
  /// here: "once a Job reaches activeDeadlineSeconds, all of its running Pods are terminated and
  /// the Job status will become type: Failed with reason: DeadlineExceeded". So a Job past this
  /// does not retry, however many retries it has left — `nextPhase` in `src/controller.ts`, where
  /// the ordering is written down and tested.
  ///
  /// Null is the shipped default and means *no Job-wide deadline*, which is Kubernetes' default
  /// too. A per-attempt clock always applies; this one applies when somebody asked for it.
  activeDeadlineSeconds  Int?
  maxBudgetUsd Float?
  /// Run in its own git worktree. Enforced at admission, not requested in a prompt.
  isolate      Boolean @default(true)
  /// The tool surface this Job may use: a JSON array of tool names, or null for the runtime's own
  /// default. A **ceiling the board enforces**, not a request — `src/admission.ts` denies anything
  /// absent from it in a `PreToolUse` hook, and hooks run before deny rules, ask rules, the
  /// permission mode and allow rules. Narrowing it is the only way to make a Job that *cannot*
  /// write, which is what a propose-then-approve gate needs in order to mean anything (ADR-010).
  allowedTools Json?
  /// Directories, repository-relative, whose skills (and commands, and agents) this Job may see —
  /// passed to the runtime as `plugins: [{ type: 'local', path }]` (ADR-012, `src/plugins.ts`).
  ///
  /// This is how a worker reaches the repository's OWN skills. The obvious route,
  /// `settingSources: ['project']`, also loads `.claude/settings.json`, where a hook is a shell
  /// command the repository author wrote — so hkb takes the half it wants and leaves settings
  /// alone. Measured: the plugin route reaches the same skills with `settingSources` still empty.
  ///
  /// Named for what it grants rather than what it is wanted for. A plugin directory loads commands
  /// and agents too, so a column called `skills` would say less than it does.
  pluginPaths  Json?

  /// The repository's contributor guide, as a repo-relative path — usually `CLAUDE.md`.
  ///
  /// Read from `Board.repoPath` before the run and put in front of the brief (`src/guide.ts`). It is
  /// a **grant**, in the same sense and for the same reason `pluginPaths` is: a document the
  /// repository wrote, steering a worker, with the operator's authority. So it is a path somebody
  /// named rather than a file hkb goes looking for.
  ///
  /// ADR-012 refused `settingSources: ['project']` because that flag is how a repository hands hkb
  /// a shell command to run. This is the half of it that was only ever a document — measured
  /// unreachable through the SDK on those terms, and reachable with `readFileSync` on any terms.
  /// Resolved against the repository and never the worktree, so a worker cannot write the guide its
  /// own next attempt obeys.
  ///
  /// A guide that cannot be read fails the attempt BEFORE the run: a Job told to follow rules it was
  /// never given would run without them, which is worse than not running.
  guide        String?
  maxRetries   Int?
  /// What this Job must produce on disk: a JSON array of repository-relative paths, copied out of
  /// the worktree into `Board.repoPath` before the checkout is released (ADR-008). Directories
  /// recurse. A declared path the run did not produce fails the attempt — that rule is the whole
  /// reason the declaration is worth writing down, and without it this is a copy loop rather than a
  /// contract. Null, not `[]`, for a Job that produces nothing outside git.
  exports      Json?
  /// The named values this Job must produce: a JSON array of plain identifiers (ADR-008's other
  /// half). The controller gives the worker a path per name, reads each back onto the Attempt when
  /// the run ends, and fails the attempt for one that is missing — the same rule `exports` follows.
  ///
  /// This is what a Job produces when it is NOT coupled to a commit. `exports` is for files;
  /// `results` is for small structured values the board keeps and a later reader consumes — a
  /// finding, a decision, a URL. Capped at 4 KB each (`src/results.ts`), because a handoff that can
  /// hold a megabyte is a worse artifact store than the one `exports` already is.
  /// What this Job is GIVEN, resolved by the controller before the run and rendered into the prompt
  /// (`src/inputs.ts`). ADR-008 declared what a Job produces and left what it consumes as `brief` —
  /// one static string.
  ///
  /// Stored the way Kubernetes stores a container's `env`: a JSON array of `{ name }` plus either a
  /// literal `value` or a `valueFrom` object naming where to fetch one. A scheme prefix inside a
  /// string would grow a query language the first time a source needs a second field, and `board`
  /// wanting a filter is not far off.
  ///
  /// Four sources, and none of them waits. `value` is the one that PUSHES — a caller hands the
  /// payload over at file time, and it is the only source allowed to interpolate into the brief,
  /// because the brief is instruction and everything fetched is data. The three that pull are
  /// `valueFrom.file` (a repo-relative path, read from `Board.repoPath` and never the worktree),
  /// `valueFrom.board` (the LLM-free board arithmetic ADR-010 decision 5 described) and
  /// `valueFrom.jobRef` (the downward API: this Job's own `id`, `slot`, `attempt` and the
  /// rest — how a run learns which of the concurrent workers it is). An input that read another
  /// Job's output would be `Job.after` with a payload, and that was rejected rather than deferred
  /// (`docs/workflow-study.md` §2) — ordering between workloads belongs to a kind.
  ///
  /// The point is **context restriction**, not convenience: paired with an `allowedTools` that
  /// excludes `Read`/`Glob`/`Grep`, a Job sees what it was given and cannot reach further, because
  /// the admission gate refuses the rest. Injection alone restricts nothing.
  ///
  /// An input that cannot be read fails the attempt BEFORE the run — `Outcome.no_input`, no money.
  inputs       Json?
  results      Json?
  /// The files this Job must produce: a JSON array of names, each one path segment. The third
  /// declared output, and the gap between the other two (ADR-011).
  ///
  /// `exports` are files the REPOSITORY keeps; `results` are small values the BOARD keeps, capped
  /// at 4 KB. An artifact is the middle: a file the board keeps, uncapped. The worker writes it to
  /// an absolute path outside every checkout — the same place a result goes and for the same reason
  /// — so an output that must not be committed is never in the tree to be committed by accident.
  /// A name may be produced as a directory, which is how an artifact holds more than one file.
  ///
  /// Unlike a result, nothing is copied onto the Attempt but the catalogue: name, kind and size.
  /// The file IS the value, so the file is what is durable, and `src/artifacts.ts` never removes
  /// one. That is a deliberate cost — see the size in `hkb show`.
  artifacts    Json?

  /// The command that says whether this Job's work *behaves*: a shell line run in the attempt's
  /// workspace after the run, whose non-zero exit fails the attempt
  /// (ADR-016 §3, `src/check.ts`).
  ///
  /// **Beside the declared outputs, not in a hooks list.** A Kubernetes Job is complete when its
  /// container exits 0, which is why Kubernetes needs no "run this afterwards" hook. hkb's
  /// container is an agent session and it always finishes successfully, so hkb has no exit code:
  /// `exports`, `results` and `artifacts` are hkb reconstructing one for files, and this is the
  /// same question asked for behaviour. The controller reads 0 / not-0 and knows nothing else
  /// about the command — the way the kubelet knows nothing about the container.
  ///
  /// **From this row, the board's default, or a workflow file under `Board.repoPath` — never the
  /// worktree.** Same fence as `guide` and `pluginPaths`, for the sharpest version of the reason:
  /// a worker that could author what judges its own next attempt would be marking its own work.
  /// A human merge is the boundary. It is deliberately not a proposal key either
  /// (`src/proposals.ts`).
  ///
  /// Null on both levels is the shipped default, and it means NOTHING RUNS — a Job whose brief is
  /// an investigation has no suite to pass, and a check hkb chose for a repository it knows
  /// nothing about would be a guess with a shell in it.
  check        String?
  /// How this Job is GROUPED: a JSON object of string → string, the way Kubernetes labels an
  /// object. `{"workflow":"release","step":"draft"}`.
  ///
  /// A map rather than a list of tags, because the pair is the thing that gets asked for — "the
  /// draft step of the release workflow" — and a flat list can only say it by inventing a separator
  /// inside the tag, which is a schema nobody wrote down. `hkb ls --label workflow=release` selects
  /// on it, equality only and ANDed across repeats (`src/labels.ts`); the richer k8s selectors
  /// (`!=`, `in`, `notin`) are each a query language and are deliberately absent.
  ///
  /// **Nothing in the controller reads this.** A label groups Jobs for whoever is looking at the
  /// board; it does not schedule, own or cascade. Ownership between Jobs is
  /// `proposedByJobId`/`proposedByK`/`proposalIndex` above, and a dependency between them is a
  /// second kind that does not exist yet (ADR-007).
  ///
  /// Nullable, so "unlabelled" is the absence of a value rather than an empty object every row
  /// carries — and so the column is a plain `ADD COLUMN` against a live board.
  labels       Json?

  /// What a human must decide before this Job goes on (ADR-010). Non-null makes the Job **gated**:
  /// an attempt that succeeds AND produced everything it declared does not go terminal — it goes
  /// `suspended`, carrying this text as `suspendedFor`, and waits.
  ///
  /// **One-shot, and deliberately.** The gate fires only while no approval has been recorded, so a
  /// Job goes propose → approve → apply and then ends like any other. A re-entrant gate would delete
  /// the Job's completion condition: every success would suspend again, `succeeded` would be
  /// unreachable, and the only terminal states left would be `cancelled` and `done` — the last of
  /// which means something else entirely, over thirty lines of comment above.
  ///
  /// Whether it has been approved is read off the Event stream rather than a flag cleared on use: a
  /// guard that only fires on a transition is wrong after a restart, and this controller is
  /// level-triggered.
  gate         String?

  /// What this Job PROPOSES: work it wants filed on the board and may not file itself (ADR-011).
  ///
  /// A string rather than a boolean because it names the closed set of things that may be proposed,
  /// and the only member today is `"jobs"`. Nullable, so "does not propose" stays the absence of a
  /// value rather than a `false` every row has to carry — and so the column is an `ADD COLUMN`
  /// against a live board rather than a table rebuild.
  ///
  /// The transport is the artifact channel: the run writes `proposal.json` into its artifact
  /// directory, the controller parses and refuses (`src/proposals.ts`), and what survives is stored
  /// on the Attempt. Nothing is created until an `approved` event exists — so the write is
  /// retry-safe, which is the argument that outranks the others: a worker that dies mid-session
  /// leaves nothing applied, where an in-session board API would leave half of it.
  ///
  /// Filing with `--propose` sets a `gate` too, because a proposal with no approver is a workload
  /// writing to the board through one more layer of indirection.
  proposes     String?

  // ---- status: what is happening. Written only by the controller.
  phase         Phase   @default(pending)
  /// The session to resume, when the last attempt left one. The one SDK fact worth a column.
  lastSessionId String?
  lastError     String?
  /// Why this Job is suspended, when it is. Not derivable from any runtime.
  suspendedFor  String?
  /// Who ended this Job by hand, and why they said they did — `done` and `cancelled` only.
  ///
  /// The pair `pausedBy`/`pausedAt` already is on Board, for the same kind of fact: a decision a
  /// person made, which nothing can recompute. `finishedAt` carries the when. It is denormalised
  /// out of the Event deliberately — `kb ls --json` and `kb show` must be able to say who concluded
  /// a Job without joining the whole stream, and an operator who reaches for `kb log` to find out
  /// why a Job is terminal is reaching one level deeper than the question deserves.
  endedBy       String?
  endedFor      String?

  /// Where this Job came from, when it came from a proposal: the attempt that proposed it
  /// (`proposedByJobId` + `proposedByK`) and its position in that proposal's list.
  ///
  /// **An observation the controller made, never a claim a worker made about itself.** The three
  /// columns together are ADR-011's natural key, and the unique constraint below is what makes
  /// applying a proposal idempotent: a second pass over the same approval re-creates the same
  /// `(job, attempt, index)` and the database refuses it. The controller does not have to remember
  /// what it already did, which is the same reason `Lease.slot` is `@unique` — a constraint that
  /// refuses beats logic that has to be right.
  ///
  /// All three null for a Job somebody filed by hand, which is nearly all of them.
  proposedByJobId Int?
  proposedByK     Int?
  proposalIndex   Int?

  attempts Attempt[]
  lease    Lease?
  events   Event[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@unique([proposedByJobId, proposedByK, proposalIndex])
  @@index([boardId, phase])
  @@index([phase])
}

/// One execution of a Job. The Pod: it is what actually dies.
model Attempt {
  jobId Int
  k     Int
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  host      String?
  runtime   String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  outcome   Outcome?
  /// The pointer. The transcript, the token counts and the turn count all hang off it in the SDK.
  sessionId String?
  summary   String?
  reason    String?

  /// The budget cap this attempt was claimed under, frozen at claim time. Never null, never
  /// re-derived.
  ///
  /// ## Why the cap is copied here rather than looked up
  ///
  /// `Job.maxBudgetUsd` is nullable now, because that is what makes `defaultMaxBudgetUsd` above
  /// mean anything. But one reader of that column is not the run itself: `gateClaim` sums, over
  /// every attempt with no `endedAt`, what the runs already in flight could still cost, and
  /// subtracts nothing for the fact that they have reported no cost yet (`committedUsd` in
  /// `src/limits.ts`). Reading the raw column there would read null for exactly the Jobs that
  /// inherit their cap. Three ways out, and this is the third:
  ///
  ///   1. resolve the spec per open attempt — an extra query per open attempt, per gate check,
  ///      in a loop that already runs once per claim;
  ///   2. join the board's defaults into that one query — cheap, and still *wrong* in the way (1)
  ///      is wrong;
  ///   3. freeze the resolved cap here.
  ///
  /// (1) and (2) differ from (3) only when a board's default changes while work is in flight, and
  /// there they are both wrong in the same direction. An attempt that started under a $1 cap runs
  /// under $1 for its whole life — the number was handed to the runtime at spawn and nothing
  /// re-reads it. So when an operator lowers `defaultMaxBudgetUsd` to $0.10 mid-flight, (1) and (2)
  /// tell the gate that three live runs have committed $0.30 when they may in fact still spend
  /// $3.00, and the gate admits work that takes the board past its ceiling. That is the exact
  /// failure `committedUsd` was added to prevent, reintroduced by the lookup. Raising the default
  /// is wrong in the harmless direction — over-charging, so the gate merely stalls — but a ceiling
  /// that is only correct when nobody edits the board is not a ceiling.
  ///
  /// It is also the Kubernetes shape one table over from where it already is. Admission stamps a
  /// Pod with the limits a LimitRange supplied; the scheduler then reads the Pod, never the
  /// namespace, and a LimitRange edited afterwards does not retroactively rewrite what is running.
  /// An Attempt is this system's Pod, and it already records what *happened* rather than what is
  /// configured — `costUsd`, `sessionId`, `outcome`. The cap it ran under is that same
  /// kind of fact, and it is the one an operator most wants beside `costUsd`.
  ///
  /// What it costs: `kb show` reports the frozen number for a past attempt, not what resolution
  /// would say today. That is the feature. An attempt that stopped on `max_budget` is only legible
  /// against the cap that actually stopped it, and `kb retry`'s refusal — "the same cap stops it in
  /// the same place" — is a claim about the failed attempt, which no amount of re-resolving can
  /// recover once the board has moved on.
  ///
  /// Only the budget is frozen. `maxTurns`, `model` and `effort` are read once, by the run itself,
  /// and nothing outside that run asks about them while it is live; a column each would be four
  /// facts kept in two places to answer no question. This one is here because another process
  /// reads it about someone else's attempt.
  maxBudgetUsd Float
  /// The per-attempt wall clock this attempt ran under, frozen at claim time for the reason the cap
  /// above is: `hkb job set --attempt-deadline` after the fact must not rewrite what stopped an
  /// earlier attempt. Kubernetes' shape one table over — admission stamps a Pod with the limits it
  /// was admitted under, and a LimitRange edited afterwards does not rewrite what is running.
  attemptDeadlineSeconds Int

  /// What this attempt handed over: the paths that actually arrived in the repository, expanded
  /// from the Job's declaration (a declared directory becomes the files under it). Null when the
  /// Job declared nothing — an empty array would say "declared, produced none", which is a
  /// different fact and one that fails the attempt.
  exported  Json?
  /// Reported for the operator's benefit only — the SDK can always recompute it from the session.
  costUsd   Float?

  /// What the run actually did, as the runtime measured it — not as the agent reported it.
  ///
  /// Both are returned by every driver (`WorkerOutcome`, `src/runtime/index.ts`) and were being
  /// dropped on the floor, which is why a Job that produced no pull request had nothing to show for
  /// itself at all. They are the record for work whose value is not a diff: an investigation that
  /// concluded there was nothing to change is a real outcome, and "18 turns, 0 refusals, $1.40" is
  /// the difference between that and a session that stalled.
  ///
  /// Nullable because an attempt that never reached the runtime — refused at the gate, crashed
  /// before the call — has no measurement rather than a measurement of zero.
  /// What this attempt produced, as `{ name: value }` — read out of the collection directory before
  /// it is removed. Null, not `{}`, for an attempt that wrote nothing: the two are different facts
  /// and only one of them is a promise kept.
  ///
  /// Two layers live here and the difference is who chose the field. A name the Job DECLARED is the
  /// filer's requirement, and its absence fails the attempt. Anything else the run left behind is
  /// VOLUNTEERED — kept and reported, never required. Hermes' handoff is the second layer alone,
  /// which is richer and guarantees nothing; requiring everything is the opposite failure, where a
  /// Job cannot say it noticed something nobody thought to ask about.
  results Json?

  /// The concurrency slot this attempt held, copied off the Lease so it survives the release.
  /// Null for an attempt claimed before slots existed. See `Lease.slot`.
  slot Int?

  /// The catalogue of what this attempt was GIVEN, as `[{ name, source, bytes }]` — never the
  /// content, which is in the prompt and in the transcript the session id points at. Null for an
  /// attempt that declared none.
  ///
  /// Recorded because it is the measurement Artic's claim needs and hkb cannot otherwise make: what
  /// a run was fed, beside what it cost (`costUsd`, `turns`). Without it, "declared inputs reduce
  /// input tokens" stays a thing read in a paper.
  inputs Json?

  /// What this attempt PROPOSED, validated: `{ jobs: [{ name, brief, maxBudgetUsd? }], clamped }`
  /// (`src/proposals.ts`). Null for an attempt that proposed nothing, and null for one whose
  /// proposal was refused — a refusal fails the attempt with the reason on `lastError` instead.
  ///
  /// Stored beside what it produced rather than in place of it: the raw `proposal.json` stays in the
  /// artifact directory, so what was proposed, what was accepted and what was created are three
  /// facts a reader can line up. A tool call leaves no such record.
  proposal Json?

  /// The catalogue of what this attempt left in its artifact directory, as
  /// `[{ name, kind, bytes }]` (ADR-011, `src/artifacts.ts`). Null, not `[]`, for an attempt that
  /// wrote none — the same distinction `results` and `exported` already draw.
  ///
  /// A catalogue rather than the content, because an artifact is unbounded by design and reading
  /// one in to record that it exists would give back the cap by another route. The same two layers
  /// as `results`: declared names are required, volunteered ones are kept and never required.
  artifacts Json?

  /// What the completion check said, when this attempt ran one and it refused:
  /// `{ command, exitCode, tail, ms, why? }` (`src/check.ts`). Null for an attempt that ran no
  /// check and for one whose check passed — a passing check is the absence of a finding, and a row
  /// per success would be a log rather than a record.
  ///
  /// It is here rather than in `reason` because it is not a sentence: `reason` is 300 characters of
  /// prose for a person reading `hkb show`, and this is the captured tail of a test run, read back
  /// by the controller to tell the NEXT attempt what failed. `docs/rebuild-plan.md` records that
  /// "the practice that has actually worked is briefing: tell the second attempt what the first
  /// collided with", and a retry that does not know why it is retrying is the failure mode this
  /// project has already measured.
  check   Json?

  turns   Int?
  /// How often the admission gate refused this run a tool. A non-zero count on a succeeding attempt
  /// is the signal that a Job's `allowedTools` is narrower than its brief needs.
  denials Int?

  @@id([jobId, k])
  @@index([endedAt])
}

/// Who holds a Job right now. The compare-and-swap is `@@id`: a second holder's insert fails,
/// and that failure is the answer. `expiresAt` is what makes a dead holder reclaimable.
model Lease {
  jobId     Int      @id
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  holder    String
  token     String
  /// Which concurrency slot this holder occupies — the lowest non-negative integer no other LIVE
  /// lease holds, machine-wide, because one board file serves one machine.
  ///
  /// It exists because a worker needs to know **which of the concurrent workers it is**, and no
  /// other fact answers that. `jobId` is unique but unbounded and grows for ever; a worker that
  /// wants a port, a display number or a database name needs a small integer bounded by how many
  /// runs there can be at once. This is the StatefulSet ordinal, and the Pod-per-IP escape
  /// Kubernetes has is exactly what hkb does not: workers share one machine's ports.
  ///
  /// `@unique` is the allocator. Two daemons computing "the lowest free slot" from the same read
  /// would compute the same answer; the constraint makes the second `create` fail, and the claim
  /// path already treats a failed lease create as "somebody else got there" and moves on. The Job
  /// is picked up on the next pass, which is what level-triggered means.
  ///
  /// Released with the lease, so a slot is only held while a run is live.
  ///
  /// **Nullable, and that is a migration decision rather than a modelling one.** A required column
  /// added to this table makes Prisma emit `RedefineTables` — DROP and recreate — against a board
  /// a daemon may be holding leases in. Nullable is a plain `ADD COLUMN`, and SQLite treats NULLs
  /// as distinct under a unique index, so old rows coexist while every new lease still gets a slot
  /// no other live lease holds. A null here means "claimed by an hkb that predates slots".
  slot      Int?     @unique
  acquiredAt DateTime @default(now())
  renewedAt  DateTime @default(now())
  expiresAt  DateTime
}

/// What happened, in order. With no git ref, this is the history.
///
/// `jobId` is null for a transition that is not about one Job — a board stopped, a daemon up or
/// down. Those still belong to a board, so `boardId` is carried separately rather than inferred
/// through the Job: `kb log` with no id is a board's whole stream, and it would lose exactly the
/// operator-level entries that explain the gaps in it.
model Event {
  id      Int      @id @default(autoincrement())
  at      DateTime @default(now())
  kind    String
  jobId   Int?
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  boardId Int?
  board   Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor   String?
  payload Json?

  @@index([jobId, id])
  @@index([boardId, id])
}
