node_modules/
# `typescript` is the only dependency and it is dev-only, so no lock file is committed — nothing
# ships from node_modules and `npm install` has nothing to pin for a user. CI installs plain and
# every setup-node keeps `package-manager-cache: false`, which needs a lock file to be absent.
package-lock.json
.kanban/logs/
.kanban/outbox.jsonl
.kanban/state.json
.kanban/dispatch.pid
.kanban/serve.pid
.kanban/serve.url
.kanban/cache.json
.kanban/nudges/
.kanban/sessions/
*.log
.claude/worktrees/
.claude/settings.local.json

# The board itself. Durable state, but a binary SQLite file has no business in git:
# it cannot be merged, and every write would be a diff nobody can read. Back it up by
# copying the file. (This is the property the old `refs/kb/boards/<slug>` tier bought
# and this design deliberately gives up.)
.kanban/*.db
.kanban/*.db-shm
.kanban/*.db-wal

# The generated Prisma client. Regenerated by `npm install` (postinstall), so it is a build
# artifact, not source. hkb needs node_modules at runtime now anyway, which is what used to
# make committing generated code worth it.
src/generated/
